# Copier en .env.local pour le développement. Ne jamais committer le fichier rempli.
# En production : Vercel → Settings → Environment Variables.

# Clé Resend (https://resend.com/api-keys). Sans elle, /api/contact répond 503
# et le formulaire propose un lien mailto: déjà rempli.
RESEND_API_KEY=

# Expéditeur — domaine vérifié chez Resend. Vide : onboarding@resend.dev
# (adresse de test qui n'écrit qu'au titulaire du compte Resend).
CONTACT_FROM=

# Destinataire(s) des demandes, séparés par des virgules.
CONTACT_TO=

# URL publique du site (balises canoniques, sitemap, image OG).
NEXT_PUBLIC_SITE_URL=https://www.mjlab.fr

# ---------------------------------------------------------------
# APPROCHE — variables d'environnement
# Copier en .env.local pour le développement (jamais committé).
# En production : Vercel → Settings → Environment Variables.
# ---------------------------------------------------------------

# --- Supabase (obligatoire en production) ------------------------
# Supabase → Project Settings → API.
# Sans ces deux valeurs, l'app démarre en « mode démo » : données
# stockées dans le navigateur, choix Jérémy / Matheis sans mot de passe.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# --- API Claude (facultatif) -------------------------------------
# Active « Lancer la recherche ici » et le « Prospect IA ».
# Sans clé : les prompts se copient et se collent dans claude.ai / ChatGPT.
# Clé à créer sur https://platform.claude.com (API Keys).
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Modèle utilisé (par défaut : claude-opus-5-5).
# ANTHROPIC_MODEL=claude-opus-5-5

# En mode démo ET en production, /api/ai est fermé par défaut
# (n'importe qui pourrait consommer la clé). Mettre 1 pour l'ouvrir
# volontairement, par exemple sur une préproduction protégée.
# ALLOW_DEMO_AI=1

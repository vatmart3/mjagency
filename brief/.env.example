# ───────────────────────────────────────────────────────────────────────
# Brief projet — MJAGENCY
#
# Copier ce fichier en .env.local pour le développement (`npm run dev`).
# En production, ces valeurs se posent dans Vercel →
# Settings → Environment Variables. Le fichier rempli ne part jamais
# dans un commit : .gitignore l'exclut déjà.
# ───────────────────────────────────────────────────────────────────────

# Clé d'API générée sur https://resend.com/api-keys.
# Elle ne sort jamais du serveur : seule la route /api/brief la lit.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Destinataire du récapitulatif, côté agence.
BRIEF_TO_EMAIL=jeremyvatuonepro@gmail.com

# Expéditeur des deux emails.
# Tant que le domaine n'est pas vérifié chez Resend, laisser cette ligne
# commentée : on retombe alors sur onboarding@resend.dev, qui n'écrit
# qu'au titulaire du compte Resend — suffisant pour tester, pas pour la
# mise en ligne.
# BRIEF_FROM_EMAIL=MJAGENCY <brief@mjagency.eu>

# Lien « Mentions légales » de la case RGPD, à la dernière étape.
# Cette variable est lue côté navigateur : n'y mettre que du public.
# NEXT_PUBLIC_LEGAL_URL=https://mjagency.eu/mentions-legales

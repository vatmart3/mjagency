# Modèle — à copier en .env.local pour `vercel dev`.
# Ne jamais committer le fichier rempli : .gitignore l'exclut déjà.
# En production, ces valeurs se posent dans Vercel → Settings → Environment Variables.

# Clé générée sur https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Expéditeur. Laisser vide tant que le domaine n'est pas vérifié chez Resend :
# on retombe alors sur onboarding@resend.dev, qui n'écrit qu'au titulaire du compte.
# MAIL_FROM=MJ Agency <contact@mjagency.eu>

# Destinataire, si autre que la valeur par défaut du code.
# MAIL_TO=vatmart3@gmail.com


# ---------------------------------------------------------------
# L'INTERFACE (/spider) — IRIS
#
# Clé générée sur https://console.anthropic.com → API Keys.
# Sans elle, la page fonctionne toujours : /api/iris répond 503 et
# l'interface bascule sur son mode hors ligne, qui sait encore donner
# l'heure, la météo, la position et le profil.
#
# La météo (/api/meteo) ne demande aucune clé.
# ---------------------------------------------------------------

# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ---------------------------------------------------------------
# ALERTE WHATSAPP / SMS — facultative
#
# Si ces variables sont absentes, rien ne change : seul l'email part.
# L'alerte ne peut jamais faire échouer un envoi ; en cas de panne,
# l'email est déjà parti et la demande n'est pas perdue.
#
# Par défaut le message ne contient que le prénom et le créneau : les
# coordonnées du prospect restent dans l'email. Passer à « complet »
# revient à faire transiter des données personnelles par le service
# choisi — à décider en connaissance de cause.
# ---------------------------------------------------------------

# callmebot (WhatsApp, gratuit) | twilio (WhatsApp ou SMS) | free-mobile (SMS)
# ALERTE_CANAL=callmebot
# ALERTE_TEL=+33611718368
# ALERTE_DETAIL=minimal

# Envoi d'essai sans passer par le formulaire. Sans cette variable, la
# route de test n'existe pas. Mettre n'importe quel mot difficile à deviner.
# ALERTE_TEST_CLE=un-mot-au-hasard

# --- WhatsApp gratuit, via CallMeBot -----------------------------
# Écrire « I allow callmebot to send me messages » au +34 644 51 95 23
# sur WhatsApp : il répond avec la clé à coller ici.
# CALLMEBOT_APIKEY=123456

# --- Twilio (WhatsApp ou SMS) ------------------------------------
# TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM=whatsapp:+14155238886     (SMS : un numéro Twilio, sans préfixe)
# ALERTE_TEL_TWILIO=whatsapp:+33611718368

# --- SMS gratuit, abonnés Free Mobile uniquement ------------------
# Espace abonné Free → Mes Options → Notifications par SMS
# FREE_USER=12345678
# FREE_PASS=xxxxxxxxxxxxxx

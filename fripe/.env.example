# Modèle — à copier en .env.local pour `npm run dev`.
# En production : Vercel → Settings → Environment Variables.
# Aucune de ces valeurs n'est envoyée au navigateur.

# Obligatoire. Clé créée sur https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Obligatoire. Le mot de passe qui protège l'app (et tes crédits API).
# Choisis-en un long : c'est la seule barrière devant ta clé.
APP_PASSWORD=change-moi-par-une-phrase-longue

# Facultatif. Secret de signature du cookie de session. Par défaut il est
# dérivé de APP_PASSWORD : changer le mot de passe déconnecte alors tous
# les appareils. Le poser permet de changer l'un sans l'autre.
# SESSION_SECRET=une-longue-chaine-aleatoire

# Facultatif. Modèle Claude utilisé pour l'analyse.
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Facultatif. Profondeur de réflexion : low (le plus rapide), medium, high.
# low suffit pour la plupart des vêtements ; medium affine les prix délicats.
# ANTHROPIC_EFFORT=low

# Facultatif. Analyses autorisées par adresse IP (fenêtre glissante).
# RATE_LIMIT_PER_MINUTE=6
# RATE_LIMIT_PER_DAY=150
